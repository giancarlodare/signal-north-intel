# Supabase project URL and the ANON / publishable key (NOT the service_role key).
# The anon key is safe to expose to the browser BECAUSE Row-Level Security
# (migrations/2026-07-09_signals_rls_review.sql) restricts all access to
# authenticated sessions. Never put SUPABASE_SERVICE_ROLE_KEY in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# Wave 3 staged-dark flag. Default off. While unset/false the MARKETING site is
# dark (unauthenticated visitors go to /login) and role gating is off. Change A
# (2026-08-03) decoupled the member portal from this flag: a SIGNED-IN member
# reaches their portal regardless, so a checkout-first purchase works before the
# flip. Flip to "true" ONLY after the RLS DDL
# (migrations/2026-07-27_wave3_member_rls.sql) is pasted and the operator has
# signed out/in once (decision D4).
PORTAL_ENABLED=false

# --- Checkout-first (change A, 2026-08-03) -----------------------------------
# The origin used in emailed sign-in links (pinned in production; must match the
# Supabase redirect allow-list / Site URL). See lib/site/origin.ts.
NEXT_PUBLIC_SITE_URL=https://signalnorthintel.com

# Member-facing transactional sends are ARMED by a deliberate flip, the same
# shape as PORTAL_ENABLED (operator: "don't wire any send path until I've
# approved the rendered result"). While off, a checkout-first purchase still
# provisions and entitles the member and LOGS the sign-in link, but sends no
# welcome. Flip to "true" only AFTER the rendered emails are approved, before
# the first live sale. The reconciliation alarm is NOT gated by this.
MEMBER_WELCOME_LIVE=false

# The reconciliation alarm's destination and senders. The alarm is the single
# out-of-window interrupt: a paid checkout that could not be provisioned. Senders
# must be on the Resend-verified domain (signalnorthintel.com).
OPERATOR_ALARM_EMAIL=giancarlo@signalnorthintel.com
# MEMBER_EMAIL_SENDER=Signal North <signal@signalnorthintel.com>
# OPERATOR_ALARM_SENDER=Signal North Alerts <signal@signalnorthintel.com>

# Stripe (server-only). A LIVE secret key is refused unless STRIPE_LIVE_APPROVED
# is also "true" (lib/billing/config.ts). Prices are operator-created and wired
# by id, never hardcoded. The webhook also needs SUPABASE_SERVICE_ROLE_KEY
# (server-only; it never reaches the browser bundle).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_APPROVED=false
# STRIPE_PRICE_WEEKLY_ANNUAL=price_...
# STRIPE_PRICE_WEEKLY_MONTHLY=price_...
# SUPABASE_SERVICE_ROLE_KEY=service-role-key   # webhook only; never client-side
